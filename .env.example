# Copy to .env for local Vinext development. Never commit the real keys.
OPENAI_API_KEY=replace-with-a-project-api-key
OPENAI_MODEL=gpt-5.6-sol

GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama does not require a key. Keep the URL server-side.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4

# Local identity fallback. Applies only to a local checkout: a deployed runtime
# never grants an identity to an unauthenticated request.
LOCAL_DEV_USER_EMAIL=local-developer@upskill.invalid
LOCAL_DEV_ROLE=facilitator

# --- Identity for a deployed runtime ----------------------------------------
# Shared secret the authenticating reverse proxy must send as
# `x-upskill-proxy-secret` before `oai-authenticated-user-*` headers are
# believed. Leave empty locally; set it wherever the app is exposed, or identity
# headers are ignored entirely. Generate one with `openssl rand -hex 32`.
TRUSTED_PROXY_SECRET=

# HMAC key for account session cookies. Required in a deployed environment;
# without it, accounts and invitations are refused rather than left unsigned.
SESSION_SECRET=

# --- Model execution limits -------------------------------------------------
# Per-learner ceilings applied to every governed model call, including judge
# ensembles and live regression batches. Estimated spend uses the same pricing
# table the cost panel displays. Leave a value unset to keep the default shown
# here; set it to 0 to disable that ceiling deliberately.
MODEL_DAILY_USD_CAP=5
MODEL_RATE_LIMIT_PER_MINUTE=30

# --- Google Meet (optional) -------------------------------------------------
# When set, scheduling a cohort session can create a real Meet space through the
# Meet REST API. Without these, a facilitator pastes a meeting link instead.
# The refresh token must belong to a Google Workspace user and carry the scopes
# meetings.space.created and meetings.space.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
