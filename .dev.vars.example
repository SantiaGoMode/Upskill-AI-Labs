# Cloudflare-compatible local bindings. Never commit the real keys.
OPENAI_API_KEY=replace-with-a-project-api-key
OPENAI_MODEL=gpt-5.6-sol

GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama does not require a key. Keep the URL server-side.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4

# Local identity fallback. Applies only to a local checkout.
LOCAL_DEV_USER_EMAIL=local-developer@upskill.invalid
LOCAL_DEV_ROLE=facilitator

# Identity and session secrets. Leave empty locally; set both in a deployed
# runtime with `wrangler secret put`.
TRUSTED_PROXY_SECRET=
SESSION_SECRET=

# Per-learner model execution ceilings. Unset keeps the default; 0 disables.
MODEL_DAILY_USD_CAP=5
MODEL_RATE_LIMIT_PER_MINUTE=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
