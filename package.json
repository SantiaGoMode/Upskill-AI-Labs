{
  "name": "upskill-ai-labs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "typecheck": "tsc --noEmit",
    "build:production": "ENVIRONMENT=production next build",
    "deploy": "firebase apphosting:rollouts:create upskill-ai-labs --project processbridge",
    "data:generate": "node scripts/generate-northwind.mjs",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:api": "playwright test api",
    "test:e2e": "playwright test e2e"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
