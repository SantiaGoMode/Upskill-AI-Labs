{
  "name": "upskill-ai-labs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:production": "ENVIRONMENT=production next build",
    "deploy": "firebase deploy --only apphosting:upskill-ai-labs --project processbridge --force",
    "data:generate": "node scripts/generate-northwind.mjs",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:api": "playwright test api",
    "test:e2e": "playwright test e2e"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "vite": "8.2.1",
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "teeny-request@9.0.0": {
      "uuid": "11.1.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
